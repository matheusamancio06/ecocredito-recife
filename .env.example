# Segredo de assinatura das sessões. OBRIGATÓRIO em produção (mín. 32 caracteres aleatórios).
SESSION_SECRET=

# Chave fixa do hash de CPF (nunca troque depois de ter usuários; é diferente do SESSION_SECRET).
IDENTITY_PEPPER=

# Modo demonstração (login simulado + dados fictícios).
# Ligado por padrão em desenvolvimento; em produção só com DEMO_MODE=1.
# DEMO_MODE=1

# Postgres gerenciado. Sem esta variável, usa o Postgres embutido em DATA_DIR.
# As migrações são aplicadas sozinhas na primeira requisição.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
# PGSSLMODE=            # "disable" (banco local sem TLS) ou "no-verify" (cifra, mas não confere o certificado: só demonstração)
# PGSSL_CA=             # certificado da autoridade do banco (Supabase: baixe no painel); na Vercel, cole o texto inteiro
# PGPOOL_MAX=5          # conexões por instância; em serverless, poucas

# Onde as fotos ficam: "fs" (disco) ou "db" (dentro do Postgres).
# Padrão: "db" quando há DATABASE_URL, "fs" caso contrário.
# PHOTO_STORAGE=db

# Login Único gov.br. As credenciais só podem ser solicitadas por um órgão público
# (https://www.gov.br/governodigital/pt-br/identidade/login-unico).
# GOVBR_CLIENT_ID=
# GOVBR_CLIENT_SECRET=
# GOVBR_REDIRECT_URI=https://SEU-DOMINIO/api/auth/govbr/callback
# GOVBR_BASE_URL=https://sso.staging.acesso.gov.br
# GOVBR_ISSUER=            # valor da claim "iss" do ID token; confirmar em homologação
# GOVBR_MIN_LEVEL=silver   # bronze | silver | gold

# Onde ficam o banco embutido e as fotos em disco (padrão: ./.data)
# DATA_DIR=
